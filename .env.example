AGENT_DATABASE_URL=sqlite:///./data/agent.db

# LLM provider — auto-detected from whichever key is set below.
# Override explicitly: anthropic | gemini
# AGENT_LLM_PROVIDER=gemini

# Gemini model (default: gemini-2.5-flash)
# AGENT_GEMINI_MODEL=gemini-2.5-flash

# Override model for Anthropic (uses provider default when blank):
# AGENT_LLM_MODEL=claude-sonnet-4-6

# Set exactly ONE provider key:
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=your-gemini-api-key-here

# File upload settings
# AGENT_UPLOAD_DIR=data/uploads
# AGENT_MAX_UPLOAD_BYTES=104857600

# Server port (note: no AGENT_ prefix)
PORT=8001

# LangSmith tracing (optional — agent works without it)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key-here
